# Database
DATABASE_URL=postgresql://price_tracker:price_tracker_dev@localhost:5500/price_tracker

# Auth
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# Paddle Billing
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token
PADDLE_API_KEY=your-paddle-api-key
PADDLE_PERSONAL_PRICE_ID=pri_your-personal-plan-price-id
PADDLE_PRO_PRICE_ID=pri_your-pro-plan-price-id
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret

# Resend (Email)
RESEND_API_KEY=re_...

# Inngest
INNGEST_APP_ID=price-tracker
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# eBay API
EBAY_APP_ID=your-ebay-client-id
EBAY_CERT_ID=your-ebay-client-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron
CRON_SECRET=change-me-to-a-random-secret
